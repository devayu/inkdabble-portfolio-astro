---
import CategorySelector from "../components/ui/category-selector";
import Layout from "../layouts/Layout.astro";
import fashionPortfolio from "@assets/fashion-portfolio.png";
import graphicPortfolio from "@assets/graphic-portfolio.png";
import { getImage } from "astro:assets";
import type { IOptimizedImages } from "src/types/types";
const unoptimizedImages = [
  {
    image: graphicPortfolio,
    name: "graphic",
    subtitle: "graphic portfolio",
    path: "graphic",
    alt: "graphic portfolio",
  },
  {
    image: fashionPortfolio,
    name: "fashion",
    subtitle: "fashion portfolio",
    path: "fashion",
    alt: "fashion portfolio",
  },
];

const optimizedImages = await Promise.all(
  unoptimizedImages.map(async (image: IOptimizedImages) => {
    const oI = await getImage({
      src: image.image,
      format: "webp",
      quality: 100,
    });
    return { ...image, optimizedImage: oI };
  }),
);
---

<Layout>
  <CategorySelector client:only images={optimizedImages} />
</Layout>
