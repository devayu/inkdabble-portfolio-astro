---
import Header from "@components/header.astro";
import "../base.css";
import "@fontsource-variable/cabin/wdth.css";
// Supports weights 400-800
import "@fontsource-variable/syne";
import "@fontsource-variable/unbounded";
import { ClientRouter } from "astro:transitions";
import { GraphicHeader } from "@components/GraphicHeader";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Graphics portfolio</title>
    <ClientRouter />
  </head>
  <body class="mx-auto min-h-screen max-w-screen-2xl">
    <GraphicHeader client:only />
    <slot />
  </body><style>
    body {
      font-family: "Syne Variable", sans-serif;
      color: #c8d4cf;
      /* font-family: "Unbounded Variable", sans-serif; */
      background-color: #020e0a;
    }
  </style>
</html>
