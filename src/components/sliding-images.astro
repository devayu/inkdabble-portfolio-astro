export const getArtboardImages = async () => {
  const files = import.meta.glob("/src/assets/artboard-*.png", {
    eager: true,
  });

  const images = Object.entries(files).map(([path, file]) => {
    const fileName = path.split("/").pop()?.replace(".png", "") || "";
    return {
      image: (file as { default: ImageMetadata }).default,
      name: fileName,
      subtitle: fileName,
      path: fileName,
      alt: fileName,
    };
  });

  // Sort by artboard number
  images.sort((a, b) => {
    const aNum = parseInt(a.name.split("-")[1]);
    const bNum = parseInt(b.name.split("-")[1]);
    return aNum - bNum;
  });

  // Optimize images
  const optimizedImages = await Promise.all(
    images.map(async (image: IOptimizedImages) => {
      const oI = await getImage({
        src: image.image,
        format: "webp",
        quality: 100,
      });
      return { ...image, optimizedImage: oI };
    }),
  );

  return optimizedImages;
};
const optimizedImages = await getArtboardImages();
---

<div
  class="flex min-h-[calc(100vh-var(--header-height))] w-full justify-center md:items-center"
>
  <Illustrations images={optimizedImages} client:load />
</div>
