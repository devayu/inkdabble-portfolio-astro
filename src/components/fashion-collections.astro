---
import savera from "@assets/savera.png";
import flawed from "@assets/flawed-beauty.jpeg";
import clo from "@assets/clo.jpeg";
import refromInStyle from "@assets/reform.png";
import patternDress from "@assets/print-design.jpeg";
import illustrations from "@assets/illustrations.png";
import { Image } from "astro:assets";
import { cn } from "@utils/utils";
import { getImage } from "astro:assets";
import { fade } from "astro:transitions";
const collections = [
  {
    image: savera,
    title: "Saanjh se Sawera",
    path: "/collections/savera",
    position: "bottom",
  },
  {
    image: refromInStyle,
    title: "Reform in Style",
    path: "/collections/reform",
    fit: "contain",
  },

  {
    image: flawed,
    title: "Flawed Beauty",
    path: "/collections/flawed-beauty",
  },
  {
    image: patternDress,
    title: "Print Design",
    path: "/collections/print-design",
  },
  {
    image: clo,
    title: "CLO 3D",
    path: "/collections/clo",
  },

  {
    image: illustrations,
    title: "Illustrations",
    path: "/collections/illustrations",
    position: "center",
  },
];
const optimizedImages = await Promise.all(
  collections.map(async (image) => {
    const oI = await getImage({
      src: image.image,
      format: "webp",
      quality: 50,
    });
    return { ...image, optimizedImage: oI };
  }),
);
---

<div
  class="flex min-h-screen flex-col items-center justify-center py-16 text-black"
>
  <div class="mx-auto max-w-7xl px-4">
    <div
      class="grid grid-cols-1 gap-40 sm:grid-cols-2 md:grid-cols-3 md:gap-60"
    >
      {
        optimizedImages.map((collection, index) => (
          <div class="flex flex-col gap-2">
            <div class="aspect-[3/4] overflow-hidden">
              <a href={collection.path}>
                <Image
                  src={collection.image}
                  alt={collection.title}
                  transition:name={`collection-image_${index}`}
                  class={cn("h-full w-full object-none")}
                  style={{
                    objectPosition: `${collection.position || "top"}`,
                    objectFit: `${collection.fit || "none"}`,
                  }}
                />
              </a>
            </div>
            <div class="flex justify-between text-black">
              <p>{`0${index + 1}`}</p>
              <p
                class="text-xs text-black"
                id="collection-title"
                transition:name={`collection-name_${collection.title}`}
              >
                {collection.title}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
