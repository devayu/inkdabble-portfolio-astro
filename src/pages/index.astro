---
import CategorySelector from "../components/ui/category-selector";
import Layout from "../layouts/Layout.astro";
import fashionPortfolio from "@assets/fashion-portfolio.png";
import graphicPortfolio from "@assets/graphic-home.png";
import { Category2 } from "@components/Category2";
import { CategorySvg } from "@components/CategorySvg";
import { CategoryTabs } from "@components/CategoryTabs";
import { getImage } from "astro:assets";
import type { IOptimizedImages } from "src/types/types";
const unoptimizedImages = [
  {
    image: graphicPortfolio,
    name: "graphic",
    subtitle: "graphic portfolio",
    path: "graphic",
    alt: "graphic portfolio",
    class: "graphic-font",
    url: "/graphic",
    videoPath: "/src/assets/graphic-vid-1.mp4",
    fillColor: "#020e0a",
  },
  {
    image: graphicPortfolio,
    name: "fashion",
    subtitle: "fashion portfolio",
    path: "fashion",
    alt: "fashion portfolio",
    class: "fashion-font",
    url: "/fashion",
    videoPath: "/src/assets/fashion-vid-1.mp4",
  },
];

const optimizedImages = await Promise.all(
  unoptimizedImages.map(async (image: IOptimizedImages) => {
    const oI = await getImage({
      src: image.image,
      format: "webp",
      quality: 100,
    });
    return { ...image, optimizedImage: oI };
  }),
);
---

<Layout>
  <Category2 client:only images={optimizedImages} />
  <!-- <CategoryTabs client:only /> -->
  <!-- <CategorySvg client:only /> -->
</Layout>
